<?xml version="1.0"?>
<!-- Generated hallway world for C.A.$.H. Main corridor along +x (2.4 m wide, 30 m long)
     with a branch going +y at x=14. Robot spawns at the origin facing +x. -->
<sdf version="1.9">
  <world name="hallway">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.5 0.5 0.5</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>-6 -6 8 0 0.6 0.8</camera_pose>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="state" type="string">floating</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View"><line own="right" target="right"/><line own="bottom" target="bottom"/></anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="VisualizeLidar" name="Visualize Lidar"/>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>13.000 -1.275 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>30.300 0.150 2.500</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>30.300 0.150 2.500</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north_a">
      <static>true</static>
      <pose>5.400 1.275 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.800 0.150 2.500</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>14.800 0.150 2.500</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north_b">
      <static>true</static>
      <pose>21.600 1.275 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.800 0.150 2.500</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12.800 0.150 2.500</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-2.075 0.000 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.150 2.700 2.500</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.150 2.700 2.500</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>28.075 0.000 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.150 2.700 2.500</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.150 2.700 2.500</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="branch_west">
      <static>true</static>
      <pose>12.725 6.200 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.150 10.150 2.500</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.150 10.150 2.500</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="branch_east">
      <static>true</static>
      <pose>15.275 6.200 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.150 10.150 2.500</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.150 10.150 2.500</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="branch_end">
      <static>true</static>
      <pose>14.000 11.275 1.250 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.700 0.150 2.500</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.700 0.150 2.500</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="door_101">
      <static>true</static>
      <pose>4.000 -1.190 1.050 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.900 0.020 2.100</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.900 0.020 2.100</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="door_102">
      <static>true</static>
      <pose>9.000 -1.190 1.050 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.900 0.020 2.100</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.900 0.020 2.100</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="door_103">
      <static>true</static>
      <pose>20.000 -1.190 1.050 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.900 0.020 2.100</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.900 0.020 2.100</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="door_104">
      <static>true</static>
      <pose>24.000 1.190 1.050 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.900 0.020 2.100</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.900 0.020 2.100</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="door_105">
      <static>true</static>
      <pose>7.000 1.190 1.050 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.900 0.020 2.100</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.900 0.020 2.100</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="door_201">
      <static>true</static>
      <pose>12.810 6.000 1.050 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.020 0.900 2.100</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.020 0.900 2.100</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="door_202">
      <static>true</static>
      <pose>15.190 9.000 1.050 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.020 0.900 2.100</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.020 0.900 2.100</size></box></geometry>
          <material><ambient>0.45 0.30 0.15 1</ambient><diffuse>0.45 0.30 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="bench">
      <static>true</static>
      <pose>6.000 -0.950 0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.200 0.400 0.450</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.200 0.400 0.450</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="trash_can">
      <static>true</static>
      <pose>18.000 0.950 0.400 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.2 1</ambient><diffuse>0.2 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="water_fountain">
      <static>true</static>
      <pose>14.000 -1.000 0.450 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.500 0.300 0.900</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.500 0.300 0.900</size></box></geometry>
